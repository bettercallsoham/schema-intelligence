# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Application Database (Prisma — stores users, snapshots, issues) ──────────
DATABASE_URL=postgresql://user:password@localhost:5432/schema_intelligence

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Target DB credentials (used by extract-schema.js script) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_target_database
DB_USER=postgres
DB_PASSWORD=

# ─── AI — Google Gemini (primary LLM) ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── AI — OpenAI (optional fallback LLM) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── CrewAI (optional — multi-agent AI assistant & PR review) ─────────────────
CREWAI_API_KEY=
CREWAI_API_URL=https://api.crewai.com
CREWAI_CREW_ID=
CREWAI_CREW_ID_POSTGRESQL=
CREWAI_CREW_ID_MYSQL=
CREWAI_CREW_ID_MSSQL=
CREWAI_CREW_ID_SNOWFLAKE=

# ─── GitHub App (optional — CI/CD PR review integration) ──────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
